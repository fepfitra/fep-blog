---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import GitHubStats from "@components/GitHubStats.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Typst } from "astro-typst/src/components";

import ThreeModel from "@components/ThreeModel.astro";

const blog = (await getCollection("blog")).filter((post) => !post.data.draft);

const modulePosts = (await getCollection("modules")).filter(
	(module) => !module.data.draft,
);

const allPosts = [...blog, ...modulePosts]
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
	await getCollection("projects")
)
	.filter((project) => !project.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allModules = await getCollection("modules");
const modules = allModules
	.filter((module) => module.id.endsWith("/module"))
	.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION} width="2xl">
	<Container size="xl">
		<!-- Hero Section -->
		<section
			class="relative mb-16 grid grid-cols-1 items-center gap-8 py-10 md:grid-cols-2 md:py-20"
		>
			<div class="animate relative z-10">
				<h1
					class="text-5xl font-bold tracking-tight text-black md:text-7xl dark:text-white"
				>
					Hi, I'm <span class="text-blue-600 dark:text-blue-400"
						>Fep</span
					>.
				</h1>
				<p
					class="mt-6 text-xl leading-relaxed text-black/75 md:w-2/3 dark:text-white/75"
				>
					I write about things I find interesting. Mostly
					cybersecurity, programming, and random tech explorations.
				</p>

				<div class="mt-8 flex flex-wrap gap-4">
					{
						SOCIALS.map((SOCIAL) => (
							<a
								href={SOCIAL.HREF}
								target="_blank"
								rel="noopener noreferrer"
								class="group flex items-center gap-2 rounded-full border border-black/10 bg-white px-5 py-2 text-sm font-medium transition-colors hover:bg-black/5 dark:border-white/10 dark:bg-[#151515] dark:text-white dark:hover:bg-white/5"
							>
								{SOCIAL.NAME}
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
								>
									<line x1="7" y1="17" x2="17" y2="7" />
									<polyline points="7 7 17 7 17 17" />
								</svg>
							</a>
						))
					}
					<a
						href={`mailto:${SITE.EMAIL}`}
						class="group flex items-center gap-2 rounded-full border border-black/10 bg-black px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-black/80 dark:border-white/10 dark:bg-white dark:text-black dark:hover:bg-white/80"
					>
						Email Me
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="size-4"
							><path
								d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
							></path><polyline points="22,6 12,13 2,6"
							></polyline></svg
						>
					</a>
				</div>
			</div>

			<div
				class="animate relative z-10 order-first flex justify-center md:order-none"
			>
				<ThreeModel />
			</div>
		</section>

		<div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
			<!-- Main Content Column (2/3 width on large screens) -->
			<div class="space-y-12 lg:col-span-2">
				<!-- Latest Posts -->
				<section class="animate space-y-6">
					<div class="flex items-center justify-between">
						<h2
							class="text-2xl font-bold text-black dark:text-white"
						>
							Latest Posts
						</h2>
						<Link href="/blog"> View all </Link>
					</div>
					<ul class="flex flex-col gap-4">
						{
							allPosts.map((post) => (
								<li>
									<ArrowCard entry={post} showType={true} />
								</li>
							))
						}
					</ul>
				</section>

				<!-- Recent Projects -->
				<section class="animate space-y-6">
					<div class="flex items-center justify-between">
						<h2
							class="text-2xl font-bold text-black dark:text-white"
						>
							Recent Projects
						</h2>
						<Link href="/projects"> View all </Link>
					</div>
					<ul class="flex flex-col gap-4">
						{
							projects.map((project) => (
								<li>
									<ArrowCard entry={project} />
								</li>
							))
						}
					</ul>
				</section>
			</div>

			<!-- Sidebar Column (1/3 width on large screens) -->
			<div class="space-y-8 lg:col-span-1">
				<!-- Modules -->
				<section class="animate space-y-6">
					<div class="flex items-center justify-between">
						<h2
							class="text-xl font-bold text-black dark:text-white"
						>
							Modules
						</h2>
						<Link href="/modules"> View all </Link>
					</div>
					<ul class="flex flex-col gap-3">
						{
							modules.map((module) => (
								<li>
									<ArrowCard entry={module} />
								</li>
							))
						}
					</ul>
				</section>

				<!-- GitHub Stats -->
				<section class="animate">
					<GitHubStats />
				</section>
			</div>
		</div>
	</Container>
</Layout>
