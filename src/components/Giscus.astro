---
import { GISCUS } from "@consts";
---

<div class="giscus"
  data-repo={GISCUS.repo}
  data-repo-id={GISCUS.repoId}
  data-category={GISCUS.category}
  data-category-id={GISCUS.categoryId}
></div>

<script is:inline>
  function loadGiscus() {
    const giscusContainer = document.querySelector(".giscus");
    if (!giscusContainer || document.querySelector(".giscus-frame")) return;

    const theme = localStorage.getItem("theme") || "system";
    const giscusAttributes = {
      src: "https://giscus.app/client.js",
      "data-repo": giscusContainer.getAttribute("data-repo"),
      "data-repo-id": giscusContainer.getAttribute("data-repo-id"),
      "data-category": giscusContainer.getAttribute("data-category"),
      "data-category-id": giscusContainer.getAttribute("data-category-id"),
      "data-mapping": "pathname",
      "data-strict": "0",
      "data-reactions-enabled": "1",
      "data-emit-metadata": "0",
      "data-input-position": "bottom",
      "data-theme": theme === "dark" ? "dark" : theme === "light" ? "light" : "preferred_color_scheme",
      "data-lang": "en",
      crossorigin: "anonymous",
      async: "",
    };

    const script = document.createElement("script");
    Object.entries(giscusAttributes).forEach(([key, value]) =>
      script.setAttribute(key, value)
    );
    giscusContainer.appendChild(script);
  }

  document.addEventListener("DOMContentLoaded", loadGiscus);
  document.addEventListener("astro:after-swap", loadGiscus);
</script>