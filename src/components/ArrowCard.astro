---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"projects">
    | CollectionEntry<"modules">;
  showType?: boolean;
};

const { entry, showType = false } = Astro.props;
---

<a
  href={`/${entry.collection}/${entry.id}`}
  data-astro-prefetch
  class="group relative flex flex-col gap-2 rounded-lg border border-black/10 bg-white p-4 transition-all duration-300 hover:border-black/20 hover:bg-black/5 hover:shadow-sm dark:border-white/10 dark:bg-[#151515] dark:hover:border-white/20 dark:hover:bg-white/5"
>
  {
    entry.collection === "projects" && entry.data.img && (
      <img
        src={entry.data.img}
        alt={entry.data.img_alt || entry.data.title}
        class="mb-2 h-48 w-full rounded-lg object-cover"
      />
    )
  }
  <div class="flex w-full items-center justify-between">
    <div class="flex flex-col truncate">
      {
        showType && (
          <div class="text-[10px] font-medium tracking-wider text-black/80 uppercase dark:text-white/80">
            {entry.collection === "blog"
              ? "Blog"
              : entry.collection === "modules"
                ? "Module"
                : "Project"}
          </div>
        )
      }
      <div class="font-semibold text-black dark:text-white">
        {entry.data.title}
      </div>
      <div class="truncate text-sm text-black/60 dark:text-white/60">
        {entry.data.description}
      </div>
    </div>

    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="size-5 -rotate-45 text-black/40 transition-transform duration-300 group-hover:rotate-0 group-hover:text-black dark:text-white/40 dark:group-hover:text-white"
    >
      <path
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M5 12h14M12 5l7 7-7 7"></path>
    </svg>
  </div>

  {
    entry.collection === "blog" && entry.data.tags && (
      <div class="mt-1 flex flex-wrap gap-2">
        {entry.data.tags.map((tag) => (
          <span class="rounded-full bg-black/5 px-2 py-0.5 text-[10px] font-medium text-black/60 dark:bg-white/10 dark:text-white/60">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</a>
